@page "/dashboard/{username}"
@model Fido2Demo.Pages.dashboardModel
@{
    ViewData["Title"] = "dashboard";
    Layout = "_Layout.cshtml";
}

<div class="section">
    <div class="container">
        <h1 class="title is-1">Dashboard for: @Model.Username</h1>

        <p>Credentials registered for this username. They are only persisted in memory on the dev server.</p>

        @if (Model.Credentials.Count == 0)
        {
            <div class="notification is-light">No credentials registered for this user.</div>
        }
        else
        {
            <div class="tags are-medium">
                <span class="tag is-success">@Model.PqcCount post-quantum (ML-DSA)</span>
                <span class="tag is-light">@Model.ClassicalCount classical (ECDSA / RSA / EdDSA)</span>
            </div>

            <table class="table is-fullwidth is-striped is-hoverable">
                <thead>
                    <tr>
                        <th>Registered</th>
                        <th>Authenticator</th>
                        <th>Algorithm</th>
                        <th>Public key</th>
                        <th>Signature</th>
                        <th>Attestation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Credentials)
                    {
                        <tr>
                            <td>
                                @row.Registered.ToString("yyyy-MM-dd HH:mm") UTC
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(row.AuthenticatorIcon))
                                {
                                    <img src="@row.AuthenticatorIcon" alt="" style="height: 1.5rem; vertical-align: middle; margin-right: .25rem" />
                                }
                                @row.Authenticator
                                @if (row.AaGuid != Guid.Empty)
                                {
                                    <br /><small><code class="has-text-grey-dark">@row.AaGuid</code></small>
                                }
                                @if (!string.IsNullOrEmpty(row.Transports))
                                {
                                    <br /><small class="has-text-grey">@row.Transports</small>
                                }
                            </td>
                            <td>
                                <strong>@row.AlgorithmName</strong> <small class="has-text-grey">(COSE @((int)row.Algorithm))</small>
                                <br />
                                @if (row.IsPqc)
                                {
                                    <span class="tag is-success">PQC</span>
                                }
                                else
                                {
                                    <span class="tag is-light">Classical</span>
                                }
                                <small class="has-text-grey">@row.KeyType</small>
                            </td>
                            <td>
                                <strong>@row.PublicKeySizeBytes.ToString("N0") bytes</strong>
                                <br /><small class="has-text-grey">@row.PublicKeySizeDetail</small>
                                <details>
                                    <summary><small>show key</small></summary>
                                    <code class="has-text-grey-dark" style="display: block; word-break: break-all; font-size: .7rem; max-width: 28rem">@row.PublicKeyBase64</code>
                                    <small class="has-text-grey">COSE key structure: @row.CoseKeySizeBytes.ToString("N0") bytes</small>
                                </details>
                            </td>
                            <td>
                                @row.SignatureSize
                            </td>
                            <td>
                                <strong>@row.AttestationFormat</strong>
                                @if (row.AttestationIsPqc)
                                {
                                    <span class="tag is-success">PQC attestation</span>
                                }
                                @if (row.AttestationChainValidationSkipped)
                                {
                                    <span class="tag is-warning" title="An attestation trust policy for this authenticator skipped certificate chain validation. The attestation signature was still verified.">chain validation skipped</span>
                                }
                                @if (!string.IsNullOrEmpty(row.AttestationSummary))
                                {
                                    <br /><small>@row.AttestationSummary</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <p class="help">
                Public key and signature sizes are what make post-quantum credentials different in practice:
                an ML-DSA-87 public key is 2,592 bytes and its signatures 4,627 bytes, against 64 bytes and about 70 bytes for ES256.
            </p>
        }
    </div>
</div>
